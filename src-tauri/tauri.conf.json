{
    "productName": "Parikaram",
    "version": "0.1.0",
    "identifier": "app.parikaram.desktop",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "macOSPrivateApi": true,
        "windows": [
            {
                "label": "main",
                "title": "Parikaram",
                "width": 1360,
                "height": 860,
                "minWidth": 960,
                "minHeight": 640,
                "decorations": true,
                "transparent": false,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/icon.png",
            "icons/icon.ico"
        ],
        "category": "Productivity",
        "shortDescription": "Lightweight native desktop and mobile browser with spatial AI work environment",
        "windows": {
            "webviewInstallMode": {
                "type": "embedBootstrapper"
            }
        },
        "macOS": {
            "minimumSystemVersion": "13.0"
        },
        "iOS": {
            "minimumSystemVersion": "16.0"
        },
        "android": {
            "minSdkVersion": 24
        }
    }
}
